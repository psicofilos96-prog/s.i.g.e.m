# Modelo sem valores. O `.env` real é gerado pelo Lovable Cloud e contém só valores públicos
# (URL, ID do projeto e chave publicável). Segredos ficam em Project Settings → Secrets, nunca aqui.
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
